# Copy this to .env and fill in your values
# .env is gitignored and never committed

GEMINI_API_KEY=your_gemini_api_key_here

# Security PINs (Dynamic Salted SHA-256 Authentication)
COACH_PIN=1777
ADMIN_PIN=9876

# Oracle Cloud (OCI) Object Storage / S3 Compatibility
S3_BUCKET_NAME=rinkside
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.ca-toronto-1.oraclecloud.com
AWS_ACCESS_KEY_ID=<your_customer_secret_key_access_key>
AWS_SECRET_ACCESS_KEY=<your_customer_secret_key_secret>
AWS_DEFAULT_REGION=ca-toronto-1
S3_PUBLIC_URL=https://objectstorage.ca-toronto-1.oraclecloud.com/n/<namespace>/b/rinkside/o/data/state.json

# Optional OCI Pre-Authenticated Request URL for web admin stream updates
STREAMS_PAR_URL=

